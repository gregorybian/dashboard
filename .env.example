# Copy to .env (install.sh does this) and keep it chmod 600. See README for each token.

# Slack app > OAuth & Permissions > User OAuth Token (xoxp-...)
SLACK_USER_TOKEN=

# monday.com avatar > Developers > My access tokens
MONDAY_TOKEN=

# Fine-grained PAT (github_pat_...), see README
GITHUB_TOKEN=

# Encrypted snapshot for gregorybian.github.io/solar-dashboard (leave blank to disable).
# The page decrypts with this password, so use a long passphrase (4+ random words).
PUBLISH_PASSWORD=
# Fine-grained PAT: owner gregorybian, only gregorybian.github.io, Contents: Read and write
PUBLISH_GITHUB_TOKEN=
